# /etc/penge/server.env on the server (root:penge, mode 0640). Never commit the real one.

# Valkey (Redis) on this server: setup-valkey.sh, run by provision.sh, fills this in.
# A Redis elsewhere must be rediss:// (TLS).
REDIS_URL=redis://default:<password>@127.0.0.1:6379

# Cloudflare R2, S3 API.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pengepassportph
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 32 random bytes each, base64: `openssl rand -base64 32`. Losing EMAIL_ENC_KEY
# loses every subscriber; changing TOKEN_SECRET breaks every unsubscribe link.
EMAIL_ENC_KEY=
EMAIL_HMAC_KEY=
TOKEN_SECRET=

# Mail through the local Postfix (deploy/mail/setup-mail.sh).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_FROM=alerts@<your-domain>
PUBLIC_BASE_URL=https://<your-domain>
# dry-run builds every email and sends none; live sends; off does neither.
MAIL_MODE=dry-run
MAIL_DAILY_LIMIT=2500
# Notification alerts (deploy/README.md, "Notifications"): off, owner or live.
PUSH_MODE=off
# npx web-push generate-vapid-keys; keep an offline copy of the private key, and never rotate them while alerts exist.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A monitored address of the site, never a personal one.
VAPID_SUBJECT=mailto:alerts@example.com
# PUSH_MODE=owner only: at least 32 random characters, e.g.
#   openssl rand -base64 33 | tr '+/' '-_' | tr -d '='
# The owner opens the site once with #owner=<token>. Revoke by changing it and restarting penge-api.
PUSH_OWNER_TOKEN=
# Notification alerts at most, and storage units at most (6 per alert). These are the defaults and the ceilings:
# measured on Valkey 8.1, 270 alerts and 1,700 units take at most 15.9 MB, under 25% of maxmemory 64mb. A value
# above a ceiling, or units below 6 x alerts, is refused at start.
DEVICE_ALERT_LIMIT=270
DEVICE_RECORD_LIMIT=1700
# A safety net: each person's pace (one an hour, or one per check) is the real limit.
ALERTS_PER_SUBSCRIBER_PER_DAY=288
# Who gets yesterday's numbers each morning (deploy/README.md, Daily numbers). Empty: R2 only.
STATS_EMAIL=
