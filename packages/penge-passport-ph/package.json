{
  "name": "penge-passport-ph",
  "version": "0.1.0",
  "description": "Read-only, rate-limited checker for DFA Philippine passport appointment availability on passport.gov.ph. Library and CLI.",
  "keywords": [
    "philippines",
    "passport",
    "dfa",
    "appointment",
    "availability",
    "passport.gov.ph",
    "rate-limited",
    "cli"
  ],
  "homepage": "https://alphaexperiments.com/pengepassportph/",
  "bugs": {
    "url": "https://github.com/alpharomercoma/penge-passport-ph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpharomercoma/penge-passport-ph.git",
    "directory": "packages/penge-passport-ph"
  },
  "license": "MIT",
  "author": "Alpha Romer Coma",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "penge-passport-ph": "./dist/cli.js",
    "penge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepack": "node ../../scripts/package-readme.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
